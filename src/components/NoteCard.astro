---
type Props = {
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  href: string;
};

const { title, summary, date, tags, href } = Astro.props;
---

<article class="flex h-full flex-col border-t border-[#dadce0] py-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <span class="text-sm font-medium text-[#1a73e8]">Build log</span>
    <time class="text-xs text-[#5f6368]" datetime={date.toISOString()}>
      {date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
    </time>
  </div>
  <h3 class="mt-3 text-xl font-medium leading-tight text-[#202124]">
    <a href={href} class="hover:text-[#1a73e8]">{title}</a>
  </h3>
  <p class="mt-3 grow leading-7 text-[#5f6368]">{summary}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
</article>
