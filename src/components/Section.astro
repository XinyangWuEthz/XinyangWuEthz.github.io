---
type Props = {
  id: string;
  eyebrow: string;
  title?: string;
  description?: string;
  class?: string;
};

const { id, eyebrow, title, description, class: className = "" } = Astro.props;
const hasHeading = Boolean(title || description);
---

<section id={id} class={`section-pad border-b border-[#dadce0] ${className}`}>
  <div class="page-shell">
    <div class={`${hasHeading ? "mb-10 max-w-3xl" : "mb-8"}`}>
      {title ? <p class="eyebrow">{eyebrow}</p> : <h2 class="section-title">{eyebrow}</h2>}
      {title && <h2 class="section-title mt-3">{title}</h2>}
      {description && <p class="mt-4 text-lg leading-8 text-[#5f6368]">{description}</p>}
    </div>
    <slot />
  </div>
</section>
