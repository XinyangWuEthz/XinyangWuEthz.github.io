---
import type { SkillGroup } from "@data/skills";

type Props = {
  skill: SkillGroup;
};

const { skill } = Astro.props;
---

<article class="border-t border-[#dadce0] py-6">
  <h3 class="text-lg font-medium text-[#202124]">{skill.title}</h3>
  <p class="mt-3 leading-7 text-[#5f6368]">{skill.body}</p>
</article>
