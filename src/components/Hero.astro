---
import { site } from "@data/site";
---

<section class="border-b border-[#dadce0] bg-white">
  <div class="page-shell grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.25fr_0.75fr] lg:items-center lg:py-24">
    <div>
      <div class="mb-8 flex gap-1" aria-hidden="true">
        <span class="h-1 w-10 bg-[#4285f4]"></span>
        <span class="h-1 w-10 bg-[#ea4335]"></span>
        <span class="h-1 w-10 bg-[#fbbc04]"></span>
        <span class="h-1 w-10 bg-[#34a853]"></span>
      </div>
      <h1 class="text-5xl font-medium leading-none tracking-normal text-[#202124] sm:text-6xl">
        Xinyang Wu
      </h1>
      <p class="mt-5 text-xl font-normal leading-8 text-[#3c4043] sm:text-2xl">
        Software Engineer focused on AI Infrastructure
      </p>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-[#5f6368]">
        ETH Z&uuml;rich MSc. Building grounded LLM assistants, production Python/FastAPI
        services, retrieval and evaluation systems, data pipelines, and Go/Kubernetes infrastructure.
      </p>
      <p class="mt-3 max-w-2xl text-base leading-7 text-[#5f6368]">
        Current engineering focus: reliable AI services, backend systems, cloud-native
        delivery, observability, and production evaluation workflows.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3" aria-label="Primary actions">
        <a class="button button-primary" href={site.links.projects}>View Projects</a>
        <a class="button button-secondary" href={site.links.resume}>Download Resume</a>
        <a class="text-link px-2" href={site.links.github}>GitHub</a>
        <a class="text-link px-2" href={site.links.linkedin}>LinkedIn</a>
        <a class="text-link px-2" href={site.links.email}>Email</a>
      </div>
    </div>
    <aside class="border-t border-[#dadce0] pt-8 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0" aria-label="Current engineering updates">
      <p class="text-sm font-medium text-[#202124]">Current work</p>
      <div class="mt-5 divide-y divide-[#dadce0] border-y border-[#dadce0]">
        <div class="py-5">
          <div class="flex items-center gap-3">
            <span class="h-2.5 w-2.5 bg-[#34a853]" aria-hidden="true"></span>
            <p class="text-sm font-medium text-[#188038]">Latest production update</p>
          </div>
          <p class="mt-2 text-sm leading-6 text-[#5f6368]">
            Documentation and Evaluation Assistant with routed retrieval, source evidence, and NDJSON streaming.
          </p>
        </div>
        <div class="py-5">
          <div class="flex items-center gap-3">
            <span class="h-2.5 w-2.5 bg-[#4285f4]" aria-hidden="true"></span>
            <p class="text-sm font-medium text-[#1a73e8]">Now building</p>
          </div>
          <p class="mt-2 text-sm leading-6 text-[#5f6368]">
            Go/Kubernetes service platform with Docker, Helm, HPA, probes, and GitHub Actions.
          </p>
        </div>
      </div>
      <div class="mt-6 grid grid-cols-4 gap-2" aria-hidden="true">
        <span class="h-1 bg-[#4285f4]"></span>
        <span class="h-1 bg-[#ea4335]"></span>
        <span class="h-1 bg-[#fbbc04]"></span>
        <span class="h-1 bg-[#34a853]"></span>
      </div>
    </aside>
  </div>
</section>
