---
import type { Experience } from "@data/experience";

type Props = {
  item: Experience;
};

const { item } = Astro.props;
---

<article class="border-t border-[#dadce0] py-8">
  <div class="grid gap-2 md:grid-cols-[1fr_auto] md:items-start">
    <div>
      <h3 class="text-xl font-medium text-[#202124]">{item.company} - {item.role}</h3>
      <p class="mt-2 text-sm text-[#5f6368]">{item.location}</p>
    </div>
    <p class="text-sm font-medium text-[#5f6368]">{item.dates}</p>
  </div>
  <p class="mt-5 max-w-3xl leading-7 text-[#5f6368]">{item.summary}</p>
  <div class="mt-6">
    <p class="text-sm font-medium text-[#3c4043]">Engineering signals</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {item.signals.map((signal) => <span class="tag">{signal}</span>)}
    </div>
  </div>
  <div class="mt-6">
    <p class="text-sm font-medium text-[#3c4043]">Highlights</p>
    <ul class="mt-3 grid gap-2 pl-5 text-sm leading-6 text-slate-700 md:grid-cols-2 md:gap-x-10">
      {item.highlights.map((highlight) => <li class="list-disc marker:text-[#5f6368]">{highlight}</li>)}
    </ul>
  </div>
</article>
